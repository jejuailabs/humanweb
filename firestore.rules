rules_version = '2';

// 03_DATA_MODEL.md 보안 규칙. 쓰기는 대부분 서버(API 라우트, 관리자 SDK)가 하므로 규칙을 우회한다.
// 클라이언트는 본인 문서 읽기와 일부 쓰기만 한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // 서버만 쓰는 영역
      match /stats/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /reports/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /daily/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /memory/{doc} { allow read, delete: if isOwner(uid); allow create, update: if false; }
      match /streak/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /analyses/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /chats/{chatId}/messages/{id} { allow read: if isOwner(uid); allow write: if false; }

      // 본인이 쓰는 영역
      match /private/{doc} { allow read, write: if isOwner(uid); }
      match /diary/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 100;
      }
    }

    match /publicProfiles/{uid} { allow read: if signedIn(); allow write: if false; }

    match /publicDiary/{id} {
      allow read: if signedIn() && resource.data.hidden == false;
      allow write: if false;
      match /hearts/{likerUid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(likerUid);
      }
    }

    match /daily/{path=**} { allow read: if signedIn(); allow write: if false; }
    match /dailyMeta/{date} { allow read: if signedIn(); allow write: if false; }
    match /tojeong/{id} { allow read: if signedIn() && id.split('_')[0] == request.auth.uid; allow write: if false; }
    match /connections/{id} { allow read: if signedIn(); allow write: if false; }

    match /stats_admin/{path=**} { allow read: if isAdmin(); allow write: if false; }
    match /reports_moderation/{id} { allow read: if isAdmin(); allow create: if signedIn(); allow update, delete: if false; }
    match /backupPool/{path=**} { allow read, write: if false; }

    // 그 밖은 모두 금지
    match /{document=**} { allow read, write: if false; }
  }
}
